NODE_ENV=development
PORT=5000

# Local MongoDB, or an Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/food_delivery

# Use a long, random string in real deployments — never reuse this example
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed origins. Defaults cover both frontends in
# this project: the React + Vite client (port 5173) and the Next.js demo
# (port 3000). Add your deployed frontend's URL here too when you host it.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Read once by `npm run seed` to create the first admin account
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@fooddelivery.com
ADMIN_PASSWORD=ChangeMe123!
